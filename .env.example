# Server-side Admin password for Admin/Edit Mode.
# Copy this file to `.env` (git-ignored) and choose your own password.
# On Vercel: Project Settings → Environment Variables → ADMIN_PASSWORD.
# NEVER prefix with VITE_ — this must stay server-side only.
ADMIN_PASSWORD=change-me

# Optional: separate secret for signing admin session cookies.
# If omitted, the secret is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
