{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branch1",
  "version": "1.0.0",
  "identifier": "com.branch1.dashboard",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Branch1",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Branch1 branch performance dashboard",
    "longDescription": "Branch1 professional branch performance dashboard for targets, sales KPIs, daily actuals and reports."
  }
}